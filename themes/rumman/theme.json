{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1770px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "red", "name": "Pomegranate", "color": "#C8102E" },
				{ "slug": "ink", "name": "Ink", "color": "#1A1A1A" },
				{ "slug": "muted", "name": "Muted", "color": "#6B6560" },
				{ "slug": "line", "name": "Line", "color": "#ECE6DF" },
				{ "slug": "cream", "name": "Cream", "color": "#FAF6F2" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter-tight",
					"name": "Inter Tight",
					"fontFamily": "\"Inter Tight\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter Tight", "fontWeight": "200 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/InterTight-latin.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Overline", "size": "0.8125rem", "fluid": false },
				{ "slug": "small", "name": "Small", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.375rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "large", "name": "Large", "size": "2.25rem", "fluid": { "min": "1.6rem", "max": "2.25rem" } },
				{ "slug": "x-large", "name": "Section", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" } },
				{ "slug": "xx-large", "name": "Display", "size": "5.25rem", "fluid": { "min": "2.75rem", "max": "5.25rem" } }
			]
		},
		"spacing": { "units": [ "px", "rem", "%", "vw" ] }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--inter-tight)", "fontSize": "1.0625rem", "fontWeight": "400", "lineHeight": "1.5" },
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "left": "clamp(20px, 3.9vw, 75px)", "right": "clamp(20px, 3.9vw, 75px)" }
		},
		"elements": {
			"link": { "color": { "text": "inherit" }, ":hover": { "color": { "text": "var(--wp--preset--color--red)" } } },
			"heading": { "typography": { "fontWeight": "400", "lineHeight": "1.1", "letterSpacing": "-0.01em" } },
			"h1": { "color": { "text": "var(--wp--preset--color--red)" }, "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h2": { "color": { "text": "var(--wp--preset--color--red)" }, "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--red)", "text": "var(--wp--preset--color--white)" },
				"border": { "radius": "0" },
				"typography": { "fontSize": "1.25rem", "fontWeight": "400" },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.75rem", "right": "1.75rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--ink)" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
